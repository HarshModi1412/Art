# ---- Copy to .env (local) or set these in your host's dashboard ----

# Supabase (the backend data store). When both are set, accounts, sessions,
# usage, purchases and per-user datasets live in Supabase. Leave them unset to
# run against the local files instead (development).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...              # Settings -> API keys -> secret (sb_secret_...)
# SUPABASE_BUCKET=user-datasets                 # optional, this is the default.
# The same bucket holds uploaded media under a media/ prefix (logos, hero art,
# hero clips, lookbook clips, product photos). It can stay PRIVATE — files are
# served through the app at /generated_images/<file>, never by a public link.
# Without Supabase, uploads live on the server's disk and are lost on redeploy.

# Encryption key for commerce credentials AND the per-user dataset blobs.
# Generate once with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Set it so encryption survives restarts and is backed up independently.
CS_SECRET_KEY=your-fernet-key

# AI features
OPENAI_API_KEY=sk-...

# Payments (only needed when LAUNCH_MODE=false)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# Instagram / Meta (optional)
# META_APP_ID=...
# META_APP_SECRET=...
# META_REDIRECT_URL=...

# ---- AI providers ---------------------------------------------------------
# Three different jobs, three different orders. Nothing here is required: the
# app degrades to templates and to your own uploaded photos without any of it.
#
# 1. READING your reference photos (Product Studio's brand aesthetic essay):
#      Gemini -> OpenAI -> Groq -> Cloudflare -> Hugging Face
#    Gemini leads because it writes the long, specific readings the essay needs
#    (hex values, f-stops, clock positions); the smaller free models stop after
#    two lines and the essay built on top of them is worth nothing.
#
# 2. DRAWING an image. The seller picks the engine per generation in the UI;
#    this order is only the DEFAULT when they do not:
#      ChatGPT (default) -> Gemini -> Cloudflare -> Hugging Face
#    ChatGPT is the default because its edit call holds on to the real product.
#    Cloudflare is offered for INVENTING a picture but never for a RE-SHOOT:
#    its only img2img model redraws the product instead of preserving it.
#    There is no silent fallback between engines — if the chosen one fails, the
#    seller is told which one failed and picks another.
#
# 3. MAKING a video clip: Hugging Face only (image-to-video, from the seller's
#    own photo). Roughly $0.20 a clip; there is no free tier for this.
#
OPENAI_API_KEY=sk-...         # image default + text; paid, ~Rs 3.70 an image
# GEMINI_API_KEY=...          # free tier, ~1,500 requests/day. Reads AND draws.
# GROQ_API_KEY=...            # free tier, fast; text and vision
# CF_ACCOUNT_ID=...           # Cloudflare Workers AI — 10,000 neurons/day free
# CF_API_TOKEN=...
# HF_API_TOKEN=hf_...         # NOTE: not a free tier — a small monthly credit
#                             # allowance, then paid. Required for VIDEO.

# Override any model id without a code change (useful when a provider retires one)
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# CF_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# HF_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell      # invent (cheap)
# HF_EDIT_MODEL=Qwen/Qwen-Image-Edit-2511              # re-shoot (conditions on your photo)
# HF_VIDEO_MODEL=Wan-AI/Wan2.2-I2V-A14B                # image-to-video

# ---- Knowing when it breaks ----------------------------------------------
# Every failure is written to a local error log with no configuration at all,
# readable at GET /api/admin/errors with the admin token below. These two make
# it come and find you instead.
# OPERATOR_EMAIL=you@yourdomain.com    # mailed on a crash, at most once an hour
#                                      # per distinct bug. Needs SMTP_HOST too.
# SENTRY_DSN=https://...               # optional; needs `pip install sentry-sdk`
# ERROR_LOG_LIMIT=200                  # how many failures to keep on disk
# ERROR_EMAIL_THROTTLE_MIN=60

# Operator-only endpoints: the error log, the deployment health check, and
# minting a reset link for a seller locked out while email is not set up. With
# this unset, all of them refuse everyone — they never default open.
# ADMIN_TOKEN=a-long-random-string
# SUPPORT_EMAIL=support@onetapmanager.com   # where a locked-out seller is told to write

# ---- A ceiling on OUR spend ---------------------------------------------
# These apply to every account on every plan, launch mode included, because the
# cost behind them is real money per call rather than a feature flag. A normal
# seller never reaches them; they exist so one enthusiastic account cannot cost
# more than its subscription in an afternoon. Defaults shown.
# AI_CAP_IMAGES_PER_DAY=40    # ~Rs 3.70 each  -> worst case ~Rs 148/account/day
# AI_CAP_VIDEOS_PER_DAY=3     # ~Rs 105 each   -> worst case ~Rs 315/account/day
# AI_CAP_VISION_PER_DAY=60    # reading reference photos
# AI_CAP_TEXT_PER_DAY=300     # captions, scripts, insights

# ---- Weekly social auto-plan (backend/core/autoplan.py) -------------------
# The Social Media Manager plans next week by itself on each seller's chosen
# day and hour (Saturday 9am by default, changeable in Social → Setup). A
# the app catches up a missed run. Each week is planned at most once.
# AUTOPLAN_SCHEDULER=on       # "off" if a cron job calls POST /api/social/autoplan/run
#                             # (X-Admin-Token header) instead
# AUTOPLAN_TZ=Asia/Kolkata    # the timezone sellers' days and hours are read in
