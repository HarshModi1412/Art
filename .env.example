# ---- Copy to .env (local) or set these in your host's dashboard ----

# Supabase (the backend data store). When both are set, accounts, sessions,
# usage, purchases and per-user datasets live in Supabase. Leave them unset to
# run against the local files instead (development).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...              # Settings -> API keys -> secret (sb_secret_...)
# SUPABASE_BUCKET=user-datasets                 # optional, this is the default

# Encryption key for commerce credentials AND the per-user dataset blobs.
# Generate once with:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Set it so encryption survives restarts and is backed up independently.
CS_SECRET_KEY=your-fernet-key

# AI features
OPENAI_API_KEY=sk-...

# Payments (only needed when LAUNCH_MODE=false)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# Instagram / Meta (optional)
# META_APP_ID=...
# META_APP_SECRET=...
# META_REDIRECT_URL=...
